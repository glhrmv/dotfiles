[user]
  name = {{ .name }}
  email = {{ .email }}
  signingkey = ~/.ssh/id_ed25519.pub

[github]
  user = {{ .github_user }}

[core]
  autocrrlf = true
  excludesfile = ~/.gitignore_global
  editor = hx

[gpg]
  format = ssh

[commit]
  gpgsign = true

[tag]
  gpgsign = true

{{ if .is_work }}
[includeIf "gitdir:{{ .personal_dir }}/"]
  path = ~/.gitconfig-personal
{{ end }}
