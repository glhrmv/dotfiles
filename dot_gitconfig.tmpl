[user]
  name = {{ .name }}
  email = {{ .email }}
  signingkey = ~/.ssh/id_ed25519.pub

[github]
  user = {{ .github_user }}

[core]
  excludesfile = ~/.gitignore_global
  editor = hx
  autocrlf = input
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  side-by-side = true
  navigate = true

[gpg]
  format = ssh

[commit]
  gpgsign = true

[tag]
  gpgsign = true

{{ if .is_work }}
[includeIf "gitdir:{{ .work_dir }}/"]
  path = ~/.gitconfig.work

[gitlab]
  user = Guilherme.Vale
{{ end }}
