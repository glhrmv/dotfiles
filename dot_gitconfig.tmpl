[user]
  name = {{ .name }}
  email = {{ .email }}
  signingkey = ~/.ssh/id_ed25519.pub

[github]
  user = {{ .github_user }}

[core]
  excludesfile = ~/.gitignore_global
  editor = hx

[gpg]
  format = ssh

[commit]
  gpgsign = true

[tag]
  gpgsign = true

{{ if .is_work }}
[includeIf "gitdir:{{ .work_dir }}"]
  path = ~/.gitconfig.work
{{ end }}
