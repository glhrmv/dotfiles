[user]
  name = {{ .name }}
  email = {{ .email }}
  signingkey = {{ .signing_key }}

[github]
  user = {{ .github_user }}

[core]
  autocrrlf = true
  excludesfile = ~/.gitignore_global
  editor = hx

[gpg]
  program = {{ output "brew" "--prefix" | trim }}/bin/gpg

[commit]
  gpgsign = {{ if .is_work }}false{{ else }}true{{ end }}
{{ if .is_work }}
[includeIf "gitdir:~/personal/"]
  path = ~/.gitconfig-personal
{{ end }}
