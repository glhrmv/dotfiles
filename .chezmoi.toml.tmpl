{{- $name := promptStringOnce . "name" "Git name" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}
{{- $githubUser := promptStringOnce . "github_user" "GitHub username" -}}
{{- $context7ApiKey := promptStringOnce . "context7_api_key" "Context7 API key" -}}
{{- $isWork := promptBoolOnce . "is_work" "Is this a work machine" -}}
{{- $workEmail := "" -}}
{{- $workDir := "" -}}
{{- $workName := "" -}}
{{- if $isWork -}}
{{-   $workEmail = promptStringOnce . "work_email" "Work email" -}}
{{-   $workDir = promptStringOnce . "work_dir" "Path to work projects directory (e.g. ~/Documents/dev/<folder>)" -}}
{{-   $workName = promptStringOnce . "work_name" "Git name for work repos" -}}
{{- end -}}

[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  github_user = {{ $githubUser | quote }}
  context7_api_key = {{ $context7ApiKey | quote }}
  is_work = {{ $isWork }}
  work_email = {{ $workEmail | quote }}
  work_dir = {{ $workDir | quote }}
  work_name = {{ $workName | quote }}
