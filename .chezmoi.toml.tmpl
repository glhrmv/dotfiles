{{- $name := promptStringOnce . "name" "Git name" -}}
{{- $email := promptStringOnce . "email" "Git email" -}}
{{- $githubUser := promptStringOnce . "github_user" "GitHub username" -}}
{{- $context7ApiKey := promptStringOnce . "context7_api_key" "Context7 API key" -}}
{{- $isWork := promptBoolOnce . "is_work" "Is this a work machine?" -}}
{{- $personalEmail := $email -}}
{{- $personalDir := "" -}}
{{- if $isWork -}}
{{-   $personalEmail = promptStringOnce . "personal_email" "Personal email (for GitHub)" -}}
{{-   $personalDir = promptStringOnce . "personal_dir" "Path to personal projects directory (e.g. ~/personal)" -}}
{{- end -}}

[data]
  name = {{ $name | quote }}
  email = {{ $email | quote }}
  github_user = {{ $githubUser | quote }}
  context7_api_key = {{ $context7ApiKey | quote }}
  is_work = {{ $isWork }}
  personal_email = {{ $personalEmail | quote }}
  personal_dir = {{ $personalDir | quote }}
